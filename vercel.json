{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "looproom-weld.vercel.app"
        }
      ],
      "destination": "https://dancerly.app/:path*",
      "permanent": false
    },
    {
      "source": "/demo",
      "destination": "/app",
      "permanent": false
    }
  ]
}
